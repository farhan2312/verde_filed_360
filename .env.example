# ─────────────────────────────────────────────────────────────
# Verde Field Intel — Environment variables
# Copy this file to `.env` and fill in the secrets.
# On Vercel, add these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Azure Database for PostgreSQL (Flexible Server)
# Host: cosmosdb1.postgres.database.azure.com  Port: 5432  DB: verde_field_360
# NOTE: Azure requires SSL — keep `?sslmode=require`.
DATABASE_URL="postgresql://cosmos_admin:REPLACE_WITH_DB_PASSWORD@cosmosdb1.postgres.database.azure.com:5432/verde_field_360?sslmode=require"

# Optional: a non-pooled direct connection (used by Prisma migrate). Same as above unless you use a pooler.
DIRECT_URL="postgresql://cosmos_admin:REPLACE_WITH_DB_PASSWORD@cosmosdb1.postgres.database.azure.com:5432/verde_field_360?sslmode=require"

# Auth — secret for signing session JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# ── ERP sales sync ──
# Bearer token for the Verde ERP sales API (uaagrostore.com/APPs/api.php). Company id defaults to 2.
SALES_API_TOKEN="REPLACE_WITH_ERP_API_TOKEN"
# SALES_API_URL="http://uaagrostore.com/APPs/api.php"
# SALES_API_COMPANY_ID="2"

# Secret the scheduler must send as `Authorization: Bearer …` to /api/cron/sales-sync.
# Vercel sets this automatically for Vercel Cron when the env var exists. Generate like AUTH_SECRET.
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Optional static password required (in addition to the sysadmin login) to use "Run sync now" on /sales-sync
# and Settings → Sales Sync. Checked server-side. If unset/blank the password prompt is disabled and manual
# sync stays sysadmin-only. Does not affect the scheduled cron run (that uses CRON_SECRET).
SALES_SYNC_PASSWORD="REPLACE_WITH_A_SYNC_PASSWORD"

# ── Transactional email (Resend) ──
# Visit review digests, weekly report notifications and SLA alerts. Until RESEND_API_KEY is set the app
# runs with email OFF: every send is recorded in EmailLog as "not configured" and nothing fails — the
# review queue, the notification bell, the weekly reports and the cron all keep working.
# Create the key at resend.com (sending access, restricted to the verified domain).
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
# Sender. The domain must be verified in Resend. Keep it a no-reply mailbox — the footer tells readers
# not to reply, and EMAIL_REPLY_TO below is deliberately left unset.
EMAIL_FROM="Verde Field Intel <noreply@verdeagrotech.com>"
# Optional: a monitored mailbox to accept replies. Leave unset/blank for no-reply.
# EMAIL_REPLY_TO="fieldintel@verdeagrotech.com"
# Optional: base URL used for links inside emails. Falls back to the Vercel production URL, then
# http://localhost:3000.
# APP_URL="https://REPLACE_WITH_THE_DEPLOYED_HOST"
