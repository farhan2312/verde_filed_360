# ─────────────────────────────────────────────────────────────
# Verde Field Intel — Environment variables
# Copy this file to `.env` and fill in the secrets.
# On Vercel, add these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Azure Database for PostgreSQL (Flexible Server)
# Host: cosmosdb1.postgres.database.azure.com  Port: 5432  DB: verde_field_360
# NOTE: Azure requires SSL — keep `?sslmode=require`.
DATABASE_URL="postgresql://cosmos_admin:REPLACE_WITH_DB_PASSWORD@cosmosdb1.postgres.database.azure.com:5432/verde_field_360?sslmode=require"

# Optional: a non-pooled direct connection (used by Prisma migrate). Same as above unless you use a pooler.
DIRECT_URL="postgresql://cosmos_admin:REPLACE_WITH_DB_PASSWORD@cosmosdb1.postgres.database.azure.com:5432/verde_field_360?sslmode=require"

# Auth — secret for signing session JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# ── ERP sales sync ──
# Bearer token for the Verde ERP sales API (uaagrostore.com/APPs/api.php). Company id defaults to 2.
SALES_API_TOKEN="REPLACE_WITH_ERP_API_TOKEN"
# SALES_API_URL="http://uaagrostore.com/APPs/api.php"
# SALES_API_COMPANY_ID="2"

# Secret the scheduler must send as `Authorization: Bearer …` to /api/cron/sales-sync.
# Vercel sets this automatically for Vercel Cron when the env var exists. Generate like AUTH_SECRET.
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
